generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model assignment {
  assignment_id  BigInt  @id @unique(map: "assignment_id") @default(autoincrement()) @db.UnsignedBigInt
  task_id        Int
  member_id      Int
  personal_notes String? @db.VarChar(255)
}

model committee {
  committee_id   BigInt  @id @unique(map: "committee_id") @default(autoincrement()) @db.UnsignedBigInt
  committee_name String? @db.VarChar(255)
  colour         String? @db.VarChar(255)
}

model member {
  member_id         BigInt    @id @unique(map: "member_id") @default(autoincrement()) @db.UnsignedBigInt
  first_name        String?   @db.VarChar(255)
  last_name         String?   @db.VarChar(255)
  date_of_birth     DateTime? @db.Date
  chapter           String?   @db.VarChar(255)
  phone_number      String?   @db.VarChar(255)
  email             String?   @db.VarChar(255)
  is_committee_head Boolean?
  firebase_uid      String?   @db.VarChar(255)
}

model membership {
  membership_id BigInt @id @unique(map: "membership_id") @default(autoincrement()) @db.UnsignedBigInt
  committee_id  Int
  member_id     Int
}

model task {
  task_id     BigInt   @id @unique(map: "task_id") @default(autoincrement()) @db.UnsignedBigInt
  task_name   String   @db.VarChar(255)
  due_date    DateTime @db.Date
  description String?  @db.VarChar(1000)
  completed   Boolean?
  attachments Json?
}

model task_committee {
  task_committee_id BigInt @id @unique(map: "task_committee_id") @default(autoincrement()) @db.UnsignedBigInt
  task_id           Int
  committee_id      Int
}
